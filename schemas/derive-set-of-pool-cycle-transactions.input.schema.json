{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pool-service/derive-set-of-pool-cycle-transactions-input",
  "title": "deriveSetOfPoolCycleTransactionsInput",
  "description": "The request derive-set-of-pool-cycle-transactions.mjs reads via --request or stdin: one closed cycle's directed-yield receipts and settled draw fees, to book against its already-persisted derive-cycle-split.mjs result.",
  "type": "object",
  "required": ["cycleId", "directedYieldReceipts", "receivedAt", "distributedAt", "recordedAt"],
  "properties": {
    "cycleId": { "type": "string", "minLength": 1 },
    "directedYieldReceipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["memberAccount", "amount", "commodity", "observedAt"],
        "properties": {
          "memberAccount": { "type": "string", "minLength": 1 },
          "amount": { "type": "string", "pattern": "^\\d+(\\.\\d+)?$" },
          "commodity": { "type": "string", "minLength": 1 },
          "observedAt": { "type": "string", "format": "date-time" },
          "txHash": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "drawFees": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["drawId", "memberAccount", "amount", "commodity", "settledAt"],
        "properties": {
          "drawId": { "type": "string", "minLength": 1 },
          "memberAccount": { "type": "string", "minLength": 1 },
          "amount": { "type": "string", "pattern": "^\\d+(\\.\\d+)?$" },
          "commodity": { "type": "string", "minLength": 1 },
          "settledAt": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    },
    "receivedAt": { "type": "string", "format": "date-time" },
    "distributedAt": { "type": "string", "format": "date-time" },
    "recordedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pool-service/reconcile-pool-books-output",
  "title": "reconcilePoolBooksOutput",
  "description": "A successful two-witness verdict or an explicit witness unavailable/refused state. Missing witness data never means an empty ledger.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "reconciled",
        "agreed",
        "mismatch",
        "postedOnly",
        "assertedOnly",
        "receipt"
      ],
      "properties": {
        "reconciled": {
          "const": true
        },
        "agreed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/posting"
          }
        },
        "mismatch": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "poolPosting",
              "memberPosting"
            ],
            "properties": {
              "poolPosting": {
                "$ref": "#/$defs/posting"
              },
              "memberPosting": {
                "$ref": "#/$defs/posting"
              }
            },
            "additionalProperties": false
          }
        },
        "postedOnly": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/posting"
          }
        },
        "assertedOnly": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/posting"
          }
        },
        "receipt": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "reconciled",
        "witnessState",
        "reason"
      ],
      "properties": {
        "reconciled": {
          "const": false
        },
        "witnessState": {
          "enum": [
            "unavailable",
            "refused"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "posting": {
      "type": "object",
      "required": [
        "date",
        "ref",
        "account",
        "amount",
        "commodity"
      ],
      "properties": {
        "date": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "account": {
          "type": "string"
        },
        "amount": {
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d+)?$"
        },
        "commodity": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}

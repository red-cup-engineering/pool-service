{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pool-service/admit-pool-member-input",
  "title": "admitPoolMemberInput",
  "description": "Membership v2 admission. Existing pools require member identity plus either the v2 resource pair or the legacy adapter; poolId and settlementWindowDays are bootstrap-only fields for creating a new pool. Witnessed admissions also require admittedAt so verification is deterministic.",
  "type": "object",
  "required": [
    "account"
  ],
  "allOf": [
    {
      "oneOf": [
        {
          "required": [
            "settlementDestinations",
            "ledgerWitness"
          ]
        },
        {
          "required": [
            "hiveAccount",
            "ledgerPath"
          ]
        }
      ]
    },
    {
      "if": {
        "required": [
          "admissionWitness"
        ]
      },
      "then": {
        "required": [
          "admittedAt"
        ]
      }
    }
  ],
  "properties": {
    "poolId": {
      "type": "string",
      "minLength": 1,
      "description": "Bootstrap-only: local pool id, required by the operation when state does not yet exist."
    },
    "settlementWindowDays": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "description": "Bootstrap-only: settlement window, required by the operation when state does not yet exist."
    },
    "creditWindowDays": {
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "poolHiveAccount": {
      "type": [
        "string",
        "null"
      ]
    },
    "account": {
      "type": "string",
      "minLength": 1
    },
    "settlementDestinations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "rail",
              "address"
            ],
            "properties": {
              "rail": {
                "const": "base"
              },
              "address": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "rail",
              "account"
            ],
            "properties": {
              "rail": {
                "const": "hive"
              },
              "account": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "ledgerWitness": {
      "type": "object",
      "required": [
        "kind",
        "recordNi",
        "provider",
        "subject"
      ],
      "properties": {
        "kind": {
          "const": "content-addressed-postings"
        },
        "recordNi": {
          "type": "string",
          "pattern": "^ni:///sha-256;[A-Za-z0-9_-]+$"
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "description": "Member-controlled or independently provided content-addressed postings witness. local-file exists only behind the legacy ledgerPath adapter."
    },
    "hiveAccount": {
      "type": "string",
      "minLength": 1,
      "deprecated": true
    },
    "baseAddress": {
      "type": [
        "string",
        "null"
      ],
      "deprecated": true
    },
    "ledgerPath": {
      "type": "string",
      "minLength": 1,
      "deprecated": true
    },
    "admissionWitness": {
      "description": "Optional: when present, verified per the membership-and-governance specification's three admission paths before the member is admitted; when absent, the pool's own unwitnessed admission applies unchanged.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "sponsorAccount",
            "pledgedAmount"
          ],
          "properties": {
            "kind": {
              "const": "sponsor-vouch"
            },
            "sponsorAccount": {
              "type": "string",
              "minLength": 1
            },
            "pledgedAmount": {
              "type": "string",
              "pattern": "^\\d+(\\.\\d+)?$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "enterpriseId"
          ],
          "properties": {
            "kind": {
              "const": "enterprise-roster"
            },
            "enterpriseId": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "discordSubjectHash",
            "guildId",
            "roleId",
            "checkedAt"
          ],
          "properties": {
            "kind": {
              "const": "turntide-islander-role"
            },
            "discordSubjectHash": {
              "type": "string",
              "minLength": 1
            },
            "guildId": {
              "type": "string",
              "minLength": 1
            },
            "roleId": {
              "type": "string",
              "minLength": 1
            },
            "checkedAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "admittedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
